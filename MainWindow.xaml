<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FontAutoLoader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FontAutoLoader"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FontAutoLoader.Models"
    mc:Ignorable="d"
    Title="FontAutoLoader - 番剧字幕字体临时加载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootWindowGrid">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded">
            <NavigationView.Resources>
                <!-- 将原生容易掉帧且跨项硬编码淡出消失的旧指示条彻底隐形 -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="字幕字体挂载" Tag="AssPage" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="字体库检索" Tag="SearchPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="目录与索引管理" Tag="FolderPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="24,16,24,24">
                <!-- 1. ASS 字幕挂载页面 (左右分栏布局，支持向左折叠收起) -->
                <Grid x:Name="AssPagePanel" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColDef" Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左半边：折叠展示已临时挂载与系统已安装字体 -->
                    <Grid x:Name="LeftFontSidePanel" Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">
                        <!-- 侧栏顶部标题与向左收起按钮 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="字体状态面板" FontSize="13" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Padding="6,4,6,4" ToolTipService.ToolTip="向左折叠侧栏" Click="ToggleLeftDrawer_Click">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
                        <!-- 上折叠面板：临时挂载字体（Auto 高度，收起时自动腾出空间） -->
                        <Expander Grid.Row="0" Header="当前临时挂载的字体" IsExpanded="True"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView x:Name="MountedFontListView" SelectionMode="None" MaxHeight="260" HorizontalAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,2,0,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <TextBlock Grid.Column="0" Text="{x:Bind}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="卸载" FontSize="11" Padding="6,2,6,2" Click="UnloadMountedItem_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>

                        <!-- 下折叠面板：系统已安装字体（* 填充剩余空间，随上方收起自动向上扩展补位） -->
                        <Expander Grid.Row="1" Header="系统已安装字体列表" IsExpanded="True"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
                            <ListView x:Name="SystemFontListView" SelectionMode="None" HorizontalAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,2,0,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                        </Grid>
                    </Grid>

                    <!-- 右半边：ASS 字幕解析与挂载主控区 -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <!-- 折叠后显示的展开按钮 -->
                                    <Button x:Name="BtnExpandDrawer" Visibility="Collapsed" Padding="8,4,8,4" ToolTipService.ToolTip="展开字体状态侧栏" Click="ToggleLeftDrawer_Click">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                    <Button Content="选择 ASS 字幕" Style="{ThemeResource AccentButtonStyle}" Click="SelectAssFile_Click" />
                                    <Button x:Name="BtnMountAll" Content="一键挂载所需字体" Click="MountAssFonts_Click" />
                                    <Button Content="一键卸载字幕字体" Click="UnmountAssFonts_Click" />
                                </StackPanel>

                                <!-- 右上角绿、蓝(主题色)、自适应文本色三色独立计数器 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCountInstalled" Text="0" FontWeight="Bold" Foreground="#107C41" FontSize="13" />
                                    <TextBlock Text="/" Opacity="0.4" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCountMounted" Text="0" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
                                    <TextBlock Text="/" Opacity="0.4" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCountTotal" Text="0" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" />
                                </StackPanel>
                            </Grid>

                            <!-- 多色分段比例进度条：绿(系统已安装) | 强调色(已挂载) | 灰(未挂载) | 红(缺失/失败) -->
                            <Grid x:Name="MultiColorProgressBar" Height="6" CornerRadius="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColInstalled" Width="0*" />
                                    <ColumnDefinition x:Name="ColMounted" Width="0*" />
                                    <ColumnDefinition x:Name="ColUnmounted" Width="1*" />
                                    <ColumnDefinition x:Name="ColError" Width="0*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#107C41" RadiusX="2" RadiusY="2" />
                                <Rectangle Grid.Column="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="2" RadiusY="2" />
                                <Rectangle Grid.Column="2" Fill="#5A5A5A" RadiusX="2" RadiusY="2" />
                                <Rectangle Grid.Column="3" Fill="#D13438" RadiusX="2" RadiusY="2" />
                            </Grid>

                            <TextBlock x:Name="AssPathText" Text="尚未选择任何字幕文件" Opacity="0.8" TextTrimming="CharacterEllipsis" FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" x:Name="AssStatusText" Text="等待导入字幕..." FontWeight="SemiBold" VerticalAlignment="Center" />
                                <!-- 视图切换下拉选项 -->
                                <ComboBox Grid.Column="1" x:Name="ViewModeComboBox" SelectedIndex="0"
                                          SelectionChanged="ViewModeComboBox_SelectionChanged"
                                          VerticalAlignment="Center" FontSize="12" MinWidth="140">
                                    <ComboBoxItem Content="整体显示 (去重)" />
                                    <ComboBoxItem Content="按 ASS 文件显示" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- 视图 1：整体去重平铺列表 -->
                        <ListView Grid.Row="1" x:Name="AssFontListView" Visibility="Visible" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AssFontItem">
                                    <Border Margin="0,4,0,4" Padding="14,0,14,0" MinHeight="68" CornerRadius="8"
                                            Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FontName}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                                    <Border CornerRadius="4" Padding="6,1,6,1" Background="{x:Bind BadgeBrush, Mode=OneWay}" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind MatchStatusText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind BadgeTextBrush, Mode=OneWay}" />
                                                    </Border>
                                                    <Button Visibility="{x:Bind HasError, Mode=OneWay}"
                                                            Content="原因"
                                                            FontSize="11"
                                                            Padding="6,1,6,1"
                                                            VerticalAlignment="Center"
                                                            Click="ShowErrorDetail_Click" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind MatchedFilePath, Mode=OneWay}"
                                                           Visibility="{x:Bind PathVisibility, Mode=OneWay}"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center"
                                                    Content="{x:Bind ActionText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsFound}"
                                                    Visibility="{x:Bind ActionButtonVisibility, Mode=OneWay}"
                                                    Click="AssFontItemActionButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 视图 2：按 ASS 文件分组折叠列表（默认收起，点击展开） -->
                        <ListView Grid.Row="1" x:Name="AssGroupedListView" Visibility="Collapsed" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AssFileGroup">
                                    <Expander IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,4,0,4">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{x:Bind FileName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind FilePath}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="8,2,8,2"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind Summary}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <Expander.Content>
                                            <ItemsControl ItemsSource="{x:Bind Fonts}" Margin="0,8,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AssFontItem">
                                                        <Border Margin="0,3,0,3" Padding="12,0,12,0" MinHeight="62" CornerRadius="8"
                                                                Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind FontName}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                                        <Border CornerRadius="4" Padding="6,1,6,1" Background="{x:Bind BadgeBrush, Mode=OneWay}" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind MatchStatusText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind BadgeTextBrush, Mode=OneWay}" />
                                                                        </Border>
                                                                        <Button Visibility="{x:Bind HasError, Mode=OneWay}"
                                                                                Content="原因"
                                                                                FontSize="11"
                                                                                Padding="6,1,6,1"
                                                                                VerticalAlignment="Center"
                                                                                Click="ShowErrorDetail_Click" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{x:Bind MatchedFilePath, Mode=OneWay}"
                                                                               Visibility="{x:Bind PathVisibility, Mode=OneWay}"
                                                                               FontSize="11"
                                                                               Opacity="0.6"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" VerticalAlignment="Center"
                                                                        Content="{x:Bind ActionText, Mode=OneWay}"
                                                                        IsEnabled="{x:Bind IsFound}"
                                                                        Visibility="{x:Bind ActionButtonVisibility, Mode=OneWay}"
                                                                        Click="AssFontItemActionButton_Click" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander.Content>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- 2. 字体搜索页面 -->
                <Grid x:Name="SearchPagePanel" Visibility="Collapsed" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="SearchBox" PlaceholderText="输入字体名称、家族名称或路径搜索..." KeyDown="SearchBox_KeyDown" />
                            <Button Grid.Column="1" Content="搜索" Style="{ThemeResource AccentButtonStyle}" Click="SearchButton_Click" />
                        </Grid>
                        <TextBlock x:Name="SearchResultCountText" Text="在上方搜索框检索字体库中的所有字体" Opacity="0.8" />
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="SearchListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FontRecord">
                                <Border Margin="0,4,0,4" Padding="12" CornerRadius="8"
                                        Background="{x:Bind BackgroundBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FontName}" FontWeight="Bold" FontSize="15" />
                                                <Border CornerRadius="4" Padding="6,1,6,1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind Format}" FontSize="11" />
                                                </Border>
                                                <!-- 高对比暖黄底黑字：无论深浅模式字迹都极为清晰锐利 -->
                                                <Border Visibility="{x:Bind WarningVisibility}" CornerRadius="4" Padding="6,1,6,1" Background="#FBC02D">
                                                    <TextBlock Text="部分名称异常" FontSize="11" FontWeight="SemiBold" Foreground="#212121" />
                                                </Border>
                                                <!-- 高对比鲜红底白字 -->
                                                <Border Visibility="{x:Bind CorruptedVisibility}" CornerRadius="4" Padding="6,1,6,1" Background="#E53935">
                                                    <TextBlock Text="彻底损坏/无法识别" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FamilyName}" FontSize="13" Opacity="0.8" />
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="切换挂载状态" Click="SearchFontItemToggle_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 3. 目录与索引管理页面 -->
                <Grid x:Name="FolderPagePanel" Visibility="Collapsed" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="添加字体目录" Click="AddFolder_Click" />
                            <Button Content="立即扫描并重建索引" Style="{ThemeResource AccentButtonStyle}" Click="RebuildIndex_Click" />
                            <Button Content="卸载所有临时字体" Click="UnloadAllFonts_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                        <TextBlock x:Name="ScanStatusText" Text="提示：首次使用请先添加字体目录，并点击【立即扫描并重建索引】。" Opacity="0.8" />
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="FolderListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Margin="0,4,0,4" Padding="12" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="移除目录" Click="RemoveFolder_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 自定义 200Hz GPU 硬件加速连续无缝滑行动画条 -->
        <Border x:Name="CustomIndicator"
                Width="3" Height="16"
                CornerRadius="1.5"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Opacity="0" />
    </Grid>
</Window>
